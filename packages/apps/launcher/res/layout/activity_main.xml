<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/apps"
    android:columnCount="3"
    android:spacing="12dp"
    android:padding="24dp"
    android:background="#ffffff">
    <ImageButton
        android:id="@+id/calendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/calendar.png"/>
    <ImageButton
        android:id="@+id/camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/camera.png"/>
    <ImageButton
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/clock.png"/>
    <ImageButton
        android:id="@+id/contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/contact.png"/>
    <ImageButton
        android:id="@+id/filebrowser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/filebrowser.png"/>
    <ImageButton
        android:id="@+id/gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/gallery.png"/>
    <ImageButton
        android:id="@+id/messager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/messager.png"/>
    <ImageButton
        android:id="@+id/settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/settings.png"/>
    <ImageButton
        android:id="@+id/video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="res/drawable/video.png"/>
</GridLayout>
